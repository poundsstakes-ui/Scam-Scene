page { background: #E9E0CB; color: #263F33; font-family: Inter, -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
button { border: 0; line-height: 1.2; min-height: 88rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
button::after { border: none; }
button:active { transform: scale(.985); filter: brightness(.96); }
button[disabled] { opacity: .48; }
.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx 64rpx; background: #E9E0CB; position: relative; z-index: 0; overflow: hidden; }
.eyebrow { color: #7B672F; font-size: 22rpx; font-weight: 800; letter-spacing: 3rpx; }
.title { margin: 8rpx 0 10rpx; font-size: 48rpx; line-height: 1.22; font-weight: 800; }
.subtle { color: #72684F; font-size: 26rpx; line-height: 1.65; }
.card { background: #FFF9E9; border: 2rpx solid #C8B47E; border-radius: 22rpx; padding: 26rpx; margin-top: 22rpx; box-sizing: border-box; box-shadow: 0 12rpx 26rpx rgba(77,59,25,.11); }
.app-background { position: absolute; z-index: -1; top: 0; left: 0; width: 100%; height: 100%; opacity: .88; pointer-events: none; }
.primary, .secondary, .art-button { position: relative; background: transparent; color: #FFFFFF; border: 0; border-radius: 14rpx; box-shadow: none; text-shadow: 0 2rpx 4rpx rgba(0,0,0,.65); overflow: hidden; }
.primary { padding: 23rpx 26rpx; font-size: 29rpx; font-weight: 800; }
.primary-plate { position: absolute; z-index: 0; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
.primary-label { position: relative; z-index: 1; }
.secondary { padding: 21rpx 24rpx; font-size: 28rpx; font-weight: 800; color: #3C2609; text-shadow: none; }
.gold-button { position: relative; overflow: hidden; background: transparent; color: #3C2609; text-shadow: none; }
.ghost { background: #FFFDF7; color: #37624A; border: 2rpx solid #C8B47E; border-radius: 14rpx; padding: 19rpx 23rpx; font-size: 27rpx; }
.tag { display: inline-block; background: #EEE0B9; color: #685728; padding: 7rpx 12rpx; border-radius: 8rpx; font-size: 21rpx; margin-right: 10rpx; }
.source { color: #887B60; font-size: 22rpx; line-height: 1.6; }
.section-title { margin-top: 34rpx; font-size: 32rpx; font-weight: 800; }
.large-text .subtle, .large-text .source, .large-text .fact, .large-text .lesson, .large-text .book-text { font-size: 34rpx; line-height: 1.45; color: #263F33; }
.large-text button, .large-text .choice, .large-text .camp-choice, .large-text .message-body { font-size: 34rpx; }
