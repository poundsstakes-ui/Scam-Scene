<view class="page party-page {{largeText ? 'large-text' : ''}}" wx:if="{{story}}">
  <image class="app-background" src="/assets/images/app-background-3d.png" mode="aspectFill"></image>
  <view class="party-header"><view class="eyebrow">五人身份局 · 预设机器人</view><view class="party-title">{{story.name}}</view><view wx:if="{{phase === 'room' || phase === 'event' || phase === 'vote'}}">剩余 {{timeText}}</view></view>
  <view wx:if="{{phase === 'pick'}}" class="card"><view class="card-title">随机抽取身份</view><view class="subtle">五个座位各有一个身份。你的身份仅在案件小书中显示。</view><image class="pick-scene" src="/assets/images/party-room-3d.png" mode="widthFix" aria-label="五位玩家围桌讨论线索"></image><button class="primary wide" bindtap="begin"><image class="primary-plate" src="/assets/images/button-primary-3d.png" mode="scaleToFill" aria-hidden="true"></image><text class="primary-label">抽取身份并进入</text></button></view>
  <view wx:if="{{phase === 'room'}}" class="room-content">
    <view class="tabletop"><view class="table-label">线索讨论桌</view><view class="table-seats"><view class="table-seat" wx:for="{{seats}}" wx:key="number"><image class="seat-avatar" src="/assets/images/role-player-3d.png" mode="aspectFill" aria-label="{{item.label}}头像"></image><view class="seat-label">{{item.label}}</view></view></view></view>
    <view class="card message-card"><view class="chat-bubble"><image class="chat-avatar" src="/assets/images/role-player-3d.png" mode="aspectFill" aria-hidden="true"></image><view class="bubble-content"><view class="message-name">{{messages[messagePage].name}}</view><view class="message-body">{{messages[messagePage].text}}</view></view></view><view class="message-nav"><button class="gold-button" bindtap="previousMessage"><image class="primary-plate" src="/assets/images/button-secondary-gold-3d.png" mode="scaleToFill" aria-hidden="true"></image><text class="primary-label">上一条</text></button><text>{{messagePage + 1}} / {{messages.length}}</text><button class="gold-button" bindtap="nextMessage"><image class="primary-plate" src="/assets/images/button-secondary-gold-3d.png" mode="scaleToFill" aria-hidden="true"></image><text class="primary-label">下一条</text></button></view></view>
    <view class="chat-input"><input value="{{messageText}}" bindinput="onInput" placeholder="说出你的判断"/><button class="chat-send" bindtap="sendMessage">发送</button><button class="chat-host" bindtap="askHost" disabled="{{hostBusy}}">{{hostBusy ? '思考中' : '问主持人'}}</button></view>
    <view class="room-actions"><button class="book-button gold-button" bindtap="toggleBook"><image class="primary-plate" src="/assets/images/button-secondary-gold-3d.png" mode="scaleToFill" aria-hidden="true"></image><text class="primary-label">案件小书</text></button><button class="vote-button art-button" bindtap="toVote"><image class="primary-plate" src="/assets/images/button-primary-3d.png" mode="scaleToFill" aria-hidden="true"></image><text class="primary-label">开始投票</text></button></view>
    <view wx:if="{{bookOpen}}" class="book-overlay"><view class="card"><view class="card-title">你的身份 · {{role.name}}</view><view class="book-text">{{role.desc}}</view><view class="book-text">{{clue}}</view><button bindtap="share" disabled="{{shared}}">{{shared ? '线索已公开' : '公开我的线索'}}</button><button bindtap="toggleBook">关闭</button></view></view>
  </view>
  <view wx:if="{{phase === 'event'}}" class="card vote-card"><view class="card-title">案件行动 · 游戏演练</view><view class="subtle">{{eventStage.clue}}</view><view class="source">假设此情境出现，选择你会采取的行动：</view><button class="event-choice" wx:for="{{eventStage.choices}}" wx:key="label" data-index="{{index}}" bindtap="safe">{{item.label}}</button></view>
  <view wx:if="{{phase === 'vote'}}" class="card vote-card"><view class="card-title">指认一名玩家</view><view class="vote-grid"><button wx:for="{{seats}}" wx:key="number" data-index="{{index}}" bindtap="vote" disabled="{{index === 0}}" class="{{vote === index ? 'active' : ''}}">{{item.label}}</button></view><view class="source">案件行动：{{caseActionText}}</view><button class="primary wide" disabled="{{vote === null || !action}}" bindtap="finish"><image class="primary-plate" src="/assets/images/button-primary-3d.png" mode="scaleToFill" aria-hidden="true"></image><text class="primary-label">提交并结算</text></button></view>
  <view wx:if="{{phase === 'result'}}" class="card party-result"><view class="card-title">{{result.caught ? '守护阵营获胜' : '引导者阵营获胜'}}</view><view class="ballot-summary">引导者为 {{result.fraudSeat}} 号，获得 {{result.votes}} 票。</view><view class="ballot-list"><text class="ballot-item" wx:for="{{result.ballotLabels}}" wx:key="voter">{{item.voter}}号 → {{item.target}}</text></view><view class="lesson">{{result.safety === 'blocked' ? '你选择暂停并独立核实。' : result.safety === 'risk' || result.safety === 'paid' ? '你选择继续进行有风险的模拟操作。' : '尚未完成独立核实。'}}<text wx:if="{{result.hadEarlierRisk}}">此前的模拟风险不会自动消失。</text></view><view wx:if="{{aiReview}}" class="source">{{reviewSource}}：{{aiReview}}</view><view wx:if="{{caseActionNote}}" class="source">{{caseActionNote}}</view><view wx:if="{{script.review}}" class="source">{{script.review}}</view><view class="source">来源：{{story.sourceTitle}}。身份与结局为游戏演练。</view><button class="primary wide" bindtap="reset"><image class="primary-plate" src="/assets/images/button-primary-3d.png" mode="scaleToFill" aria-hidden="true"></image><text class="primary-label">重新抽取身份</text></button><button class="secondary wide" bindtap="back"><image class="primary-plate" src="/assets/images/button-secondary-gold-3d.png" mode="scaleToFill" aria-hidden="true"></image><text class="primary-label">返回大厅</text></button></view>
</view>
