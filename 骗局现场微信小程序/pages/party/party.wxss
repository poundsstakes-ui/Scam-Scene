 }.chat-input input { flex: 1; min-width: 0; background: #F8F2E4; border-radius: 9rpx; padding: 10rpx; font-size: 22rpx; }.chat-input button { background: #285E47; color: #FFF; font-size: 21rpx; padding: 0 17rpx; border-radius: 9rpx; }.room-actions { display: flex; gap: 12rpx; margin-top: 10rpx; }.book-button,.vote-button { flex: 1; border-radius: 12rpx; padding: 15rpx 8rpx; font-size: 23rpx; font-weight: 800; }.book-button { background: #E9D7A2; color: #59451C; }.vote-button { background: #D96348; color: #FFF; }.book-mask { position: fixed; inset: 0; background: rgba(11,36,27,.28); z-index: 10; }.case-book { position: fixed; z-index: 11; right: -560rpx; top: 164rpx; bottom: 18rpx; width: 560rpx; min-height: 0; display: flex; transition: right .25s ease; }.case-book.book-open { right: 0; }.book-spine { width: 78rpx; box-sizing: border-box; padding: 20rpx 12rpx; background: #244C3B; border: 4rpx solid #C9A858; border-right: 0; border-radius: 16rpx 0 0 16rpx; color: #F9E8B6; text-align: center; font-size: 34rpx; box-shadow: -8rpx 8rpx 20rpx rgba(0,0,0,.18); }.spine-label { display: block; writing-mode: vertical-rl; font-size: 18rpx; margin: 10rpx auto 0; }.book-pages { flex: 1; min-width: 0; background: #FFF8E8; border: 4rpx solid #C9A858; border-right: 0; border-radius: 16rpx 0 0 16rpx; padding: 18rpx 16rpx; box-shadow: -10rpx 10rpx 26rpx rgba(0,0,0,.2); }.book-title { display: flex; justify-content: space-between; font-size: 27rpx; font-weight: 850; color: #355442; }.book-close { color: #A87B38; padding: 0 8rpx; }.book-tabs { display: flex; gap: 8rpx; margin: 14rpx 0; }.book-tab { flex: 1; padding: 11rpx 4rpx; font-size: 21rpx; color: #6C653F; background: #F0E4BE; border-radius: 9rpx; }.book-tab.tab-on { background: #2B614A; color: #FFF; }.book-page { color: #3E513F; font-size: 22rpx; line-height: 1.48; }.book-role { font-size: 29rpx; font-weight: 850; margin: 10rpx 0 6rpx; }.book-copy { margin-top: 12rpx; }.book-clue { display: block; width: 100%; padding: 11rpx 7r